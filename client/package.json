{
  "name": "ossi-client",
  "type": "module",
  "license": "MIT",
  "author": "The Ossi Developers",
  "scripts": {
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "preview": "vite preview --port 3005",
    "prod-licenses": "pnpm exec license-checker-rseidelsohn --excludePrivatePackages --production --summary",
    "start": "vite",
    "trans-copy": "cp public/locales/en/translation.json ./",
    "trans-merge": "pnpm exec tsx translation-utils.ts merge",
    "trans-parse": "pnpm exec i18next 'src/**/*.{ts,tsx}' -c i18next-parser.config.js -o 'public/locales/$LOCALE/$NAMESPACE.json'",
    "trans-rename": "pnpm exec tsx translation-utils.ts rename"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/types": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/spdx-expression-parse": "^4.0.0",
    "@xyflow/react": "^12.11.6",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.14",
    "elkjs": "^0.12.0",
    "formik": "^2.4.9",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-cli": "^1.73.1",
    "i18next-http-backend": "^4.0.2",
    "mui-one-time-password-input": "^7.0.0",
    "notistack": "^3.0.2",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-global-modal": "https://github.com/gubo97000/react-global-modal/releases/download/v0.0.28/react-global-modal-0.0.28.tgz",
    "react-i18next": "^17.0.13",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.3",
    "styled-components": "^6.5.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/readline-sync": "^1.4.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "readline-sync": "^1.4.10",
    "rollup-plugin-license": "^3.7.1",
    "sass": "^1.104.0",
    "spdx-expression-parse": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}